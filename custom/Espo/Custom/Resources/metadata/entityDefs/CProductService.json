{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "category": {
            "type": "enum",
            "required": true,
            "options": [
                "Software",
                "Hardware",
                "Service",
                "Consulting",
                "Other"
            ],
            "style": [],
            "default": "Software",
            "maxLength": 100,
            "isCustom": true
        },
        "type": {
            "type": "enum",
            "required": true,
            "options": [
                "Product",
                "Service",
                "Package",
                "Subscription"
            ],
            "style": [],
            "default": "Product",
            "maxLength": 100,
            "isCustom": true
        },
        "price": {
            "type": "currency",
            "required": true,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "required": true,
            "options": [
                "Active",
                "Inactive",
                "Discontinued"
            ],
            "style": [],
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "calls": {
            "type": "linkMultiple"
        },
        "leads": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "calls": {
            "type": "hasMany",
            "relationName": "cCallProductService",
            "foreign": "cProductServices",
            "entity": "Call",
            "audited": false,
            "isCustom": true
        },
        "leads": {
            "type": "hasMany",
            "relationName": "cLeadProductService",
            "foreign": "cProductServices",
            "entity": "Lead",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}